# LLM 클라이언트 설정 — app/clients/llm_client.py 참고
# 실제 값은 이 파일이 아니라 로컬 .env(git 제외)에만 넣으세요. 이 파일은 git에 커밋되는 템플릿입니다.

# openai: 로컬 개발용(OpenAI API 직접 호출) / internal: 사내망 전용(사내 GenAI 포탈)
LLM_PROVIDER=openai

# ── LLM_PROVIDER=openai 일 때 사용 ──────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── LLM_PROVIDER=internal 일 때 사용 (사내망 전용) ──────────────
GENAI_BASE_URL=
KB_KEY=
